<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RollForward>LatestMajor</RollForward>
    <DebugType>embedded</DebugType>
    <RootNamespace>WindowTextInjector</RootNamespace>
    <AssemblyName>WindowTextInjector</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Daweki</Authors>
    <Company>Daweki</Company>
    <Copyright>Copyright © 2026 Daweki</Copyright>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Description>Remote &amp; Local Target Text Typer with low-level keyboard simulation</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
